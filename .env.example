# Local development calls Django directly. Cloudflare Pages builds use VITE_API_URL=/.
VITE_API_URL=http://localhost:8000

# Cloudflare Pages deployment: set VITE_API_URL=/ in build variables.
# Set API_ORIGIN in Cloudflare's production runtime variables for the API proxy.
# This local .env file does not configure the deployed Pages Function.
# Use the backend HTTPS origin only, without a path. Do not prefix it with VITE_.
# API_ORIGIN=https://api.example.com
